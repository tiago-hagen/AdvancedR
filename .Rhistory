library(tidyverse)
library(dplyr)
library(janitor)
dataset1 <- read.table("data/SocialMediaImpactonDailyLives.csv" , sep=",", header = TRUE, stringsAsFactors = FALSE, check.names= FALSE)
dataset1 <- clean_names(dataset1)
glimpse(dataset1)
summary(dataset1)
missing_values <- any(is.na(dataset1))
missing_values
unique_profession <- unique(dataset1$What.is.your.profession.)
unique_profession
# Invalid value in column “What is your profession”: Male instead of profession.
unique_checker <- function(dataset) {
for (col in names(dataset)) {
cat("\nColumn:", col, "\n")
print(unique(dataset[[col]]))
}
}
####unique_checker <- function(dataset) {
#lapply(dataset, unique)
#}
unique_checker(dataset1)
#Or just for specific columns
unique_checker_specific_columns <- function(dataset, columns) {
for (col in columns) {
cat("\nColumn:", names(dataset)[col], "\n")
print(unique(dataset[[col]]))
}
}
unique_checker_specific_columns(dataset1,c("Does.social.media.advertising.influence.the.purchase.of.your.product."))
ggplot(dataset1, aes(x = On.an.average.how.many.hours.a.day.do.you.spend.on.these.sites.,
fill = Do.you.consider.yourself.addicted.to.social.media.)) +
geom_bar(position = "dodge") +
theme_minimal() +
labs(title = "Relationship: Social Media Usage vs. Self-Reported Addiction",
x = "Average Daily Hours Spent on Social Media",
y = "Number of Respondents",
fill = "Considered Addicted?")
clomuns(dataset1)
columns(dataset1)
cols(dataset1)
col(dataset1)
col_names(dataset1)
colnames(dataset1)
colnames(dataset1)
social_media <- dataset1
social_media %>%
count(
gender = what_is_your_gender,
advertising_influence = does_social_media_advertising_influence_the_purchase_of_your_product
) %>%
group_by(gender) %>%
mutate(percent = n / sum(n) * 100) %>%
ggplot(aes(
x = advertising_influence,
y = percent,
fill = gender
)) +
geom_col(position = "dodge") +
labs(
title = "Influence of Social Media Advertising by Gender",
x = "Advertising influence on purchase decision",
y = "Percentage within gender group",
fill = "Gender"
) +
theme_minimal()
ggplot(dataset1, aes(x = on_an_average_how_many_hours_a_day_do_you_spend_on_these_sites,
fill = do_you_consider_yourself_addicted_to_social_media)) +
geom_bar(position = "dodge") +
theme_minimal() +
labs(title = "Relationship: Social Media Usage vs. Self-Reported Addiction",
x = "Average Daily Hours Spent on Social Media",
y = "Number of Respondents",
fill = "Considered Addicted?")
