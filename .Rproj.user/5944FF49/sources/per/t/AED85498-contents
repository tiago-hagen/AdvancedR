```{r}

social_media <- dataset1
social_media %>%
  count(
    gender = what_is_your_gender,
    advertising_influence = does_social_media_advertising_influence_the_purchase_of_your_product
    ) %>%
  group_by(gender) %>%
  mutate(percent = n / sum(n) * 100) %>%
  ggplot(aes(
    x = advertising_influence,
    y = percent,
    fill = gender
  )) +
  geom_col(position = "dodge") +
  labs(
    title = "Influence of Social Media Advertising by Gender",
    x = "Advertising influence on purchase decision",
    y = "Percentage within gender group",
    fill = "Gender"
  ) +
  theme_minimal()
```

