```{r}
#Or just for specific columns
unique_checker_specific_columns <- function(dataset, columns) {
  for (col in columns) {
    cat("\nColumn:",col, "\n")
    print(unique(dataset[[col]]))
  }
}

```

```{r}
unique_checker_specific_columns(
  dataset1, names(dataset1)[ !names(dataset1) %in% c(
    "x",
    "what_social_networking_sites_do_you_use",
    "enter_your_name"
  )]
)
```

